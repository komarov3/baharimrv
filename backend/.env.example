# BahariMRV Backend Configuration Example
# Copy to .env and supply your environment-specific values
# Never commit .env with real credentials to git

# ============================================================================
# ENVIRONMENT & SERVER
# ============================================================================

# Environment: development, staging, production
# Production enforces HTTPS, PostgreSQL with SSL, and mandatory security configs
APP_ENV=production

# Server port
PORT=8080

# Public base URL (MUST be HTTPS in production)
PUBLIC_BASE_URL=https://api.baharimrv.example.com

# ============================================================================
# DATABASE
# ============================================================================

# PostgreSQL connection string (REQUIRED for production, SSL enforced)
# Format: postgresql://user:password@host:port/database?sslmode=require
DATABASE_URL=postgresql://baharimrv_user:changeme@localhost:5432/baharimrv?sslmode=require

# ============================================================================
# SECURITY & ENCRYPTION
# ============================================================================

# Key Encryption Key - Base64-encoded 32-byte key (REQUIRED in production)
# Generate with: openssl rand -base64 32
KMS_KEK=

# Session time-to-live (default: 1h)
SESSION_TTL=1h

# OIDC signing private key (REQUIRED in production)
# Generate with: openssl ecparam -genkey -name prime256v1 -noout -out oidc-key.pem
# Then base64 encode or paste PEM directly
OIDC_SIGNING_PRIVATE_KEY=

# OIDC signing key ID (REQUIRED in production)
OIDC_SIGNING_KID=baharimrv-prod-2026

# OIDC issuer URL (defaults to PUBLIC_BASE_URL)
OIDC_ISSUER=https://api.baharimrv.example.com

# ============================================================================
# CORS & SECURITY
# ============================================================================

# Comma-separated list of allowed origins (REQUIRED in production, no wildcards)
CORS_ORIGINS=https://app.baharimrv.example.com,https://admin.baharimrv.example.com

# Rate limiting
AUTH_RATE_PER_MINUTE=10
PUBLIC_RATE_PER_MINUTE=30

# Maximum request body size in bytes (default: 2MB)
MAX_REQUEST_BYTES=2097152

# ============================================================================
# JAHAZI SSO FEDERATION
# ============================================================================

# Federation clients mapping: issuer=client_id (comma-separated)
# Format: https://jahazi.example.com=baharimrv_client_id
# Both platforms can now authenticate users from each other
FEDERATION_CLIENTS=https://auth.jahazi.ke=baharimrv_jahazi_client

# ============================================================================
# IOTA BLOCKCHAIN
# ============================================================================

# Chain mode: iota (REQUIRED for production) or sandbox (development only)
CHAIN_MODE=iota

# IOTA network: mainnet or testnet
IOTA_NETWORK=testnet

# IOTA RPC URL
IOTA_RPC_URL=https://api.testnet.iota.cafe

# IOTA Executor service URL (for transaction building)
IOTA_EXECUTOR_URL=

# IOTA Package ID (deployed Move contract)
IOTA_PACKAGE_ID=

# IOTA Explorer URL (optional, for transaction links)
IOTA_EXPLORER_URL=https://explorer.rebased.iota.org/testnet

# ============================================================================
# EXTERNAL INTEGRATIONS
# ============================================================================

# Satellite imagery mode: integrated, unavailable, or sandbox
SATELLITE_MODE=sandbox

# Registry mode: integrated, unavailable, or sandbox
REGISTRY_MODE=sandbox

# Payment mode: integrated, unavailable, or sandbox
PAYMENT_MODE=sandbox

# Evidence storage root directory
EVIDENCE_ROOT=data/evidence

# ============================================================================
# DEMO DATA (DEVELOPMENT ONLY)
# ============================================================================

# Seed demo data on startup (FORBIDDEN in production)
# Set to true for local development with realistic placeholder data
SEED_DEMO_DATA=false

# Password for demo accounts (REQUIRED if SEED_DEMO_DATA=true)
# Demo accounts: manager@, monitor@, verifier@, buyer@, finance@, admin@demo.baharimrv.local
DEMO_SEED_PASSWORD=
