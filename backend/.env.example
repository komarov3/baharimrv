# BahariMRV Backend Configuration Example
# Copy to .env and supply your environment-specific values
# Never commit .env with real credentials to git (.env is gitignored)
#
# Fly.io + Neon production deployment:
#   1. Create a Neon project and copy its connection string (sslmode=require)
#   2. flyctl secrets set DATABASE_URL="<neon string>" -a baharimrv-api
#   3. flyctl deploy -a baharimrv-api

# ============================================================================
# ENVIRONMENT & SERVER
# ============================================================================

# Environment: development, staging, production
# Production enforces HTTPS, PostgreSQL with SSL, and mandatory security configs
APP_ENV=production

# Server port
PORT=8080

# Public base URL (MUST be HTTPS in production — your Fly.io app URL)
PUBLIC_BASE_URL=https://baharimrv-api.fly.dev

# ============================================================================
# DATABASE (Neon PostgreSQL — REQUIRED for production, SSL enforced)
# ============================================================================

# Format: postgresql://user:password@<endpoint>.aws.<region>.neon.tech/db?sslmode=require
# Get this from the Neon console. Set as a Fly.io secret (never in .env):
#   flyctl secrets set DATABASE_URL="..." -a baharimrv-api
DATABASE_URL=postgresql://baharimrv_user:changeme@ep-xxxx.aws.us-east-1.neon.tech/baharimrv?sslmode=require

# ============================================================================
# SECURITY & ENCRYPTION
# ============================================================================

# Key Encryption Key - Base64-encoded 32-byte key (REQUIRED in production)
# Generate with: openssl rand -base64 32
KMS_KEK=

# Session time-to-live (default: 1h)
SESSION_TTL=1h

# OIDC signing private key (REQUIRED in production)
# Generate with: openssl ecparam -genkey -name prime256v1 -noout -out oidc-key.pem
# Then base64 encode or paste PEM directly
OIDC_SIGNING_PRIVATE_KEY=

# OIDC signing key ID (REQUIRED in production)
OIDC_SIGNING_KID=baharimrv-prod-2026

# OIDC issuer URL (defaults to PUBLIC_BASE_URL)
OIDC_ISSUER=https://baharimrv-api.fly.dev

# ============================================================================
# CORS & SECURITY
# ============================================================================

# Comma-separated list of allowed origins (REQUIRED in production, no wildcards)
CORS_ORIGINS=https://baharimrv-api.fly.dev

# Rate limiting
AUTH_RATE_PER_MINUTE=10
PUBLIC_RATE_PER_MINUTE=30

# Maximum request body size in bytes (default: 2MB)
MAX_REQUEST_BYTES=2097152

# ============================================================================
# JAHAZI SSO FEDERATION
# ============================================================================

# Federation clients mapping: issuer=client_id (comma-separated)
# Format: https://jahazi.example.com=baharimrv_client_id
# Both platforms can now authenticate users from each other
FEDERATION_CLIENTS=https://auth.jahazi.ke=baharimrv_jahazi_client

# ============================================================================
# IOTA BLOCKCHAIN
# ============================================================================

# Chain mode: iota (REQUIRED for production) or sandbox (development only)
# For development: set to 'iota' with the testnet vars below
CHAIN_MODE=sandbox

# IOTA Rebased Testnet — the ONLY supported chain target for this release.
# All anchoring, DID provisioning, and provenance events use this network.
# DID method: did:iota:testnet:<id>  (IOTA Identity v2, Rebased testnet)
IOTA_NETWORK=testnet

# IOTA Rebased Testnet RPC endpoint
IOTA_RPC_URL=https://api.testnet.iota.cafe

# IOTA Executor service URL (BahariLink transaction builder — required for CHAIN_MODE=iota)
# Must include the /anchor path: https://<executor-app>.fly.dev/anchor
IOTA_EXECUTOR_URL=https://baharimrv-executor.fly.dev/anchor

# IOTA Move contract package ID (deployed on testnet)
IOTA_PACKAGE_ID=

# IOTA Testnet explorer — used in proof documents and certificate links
# Must match NEXT_PUBLIC_IOTA_EXPLORER_URL in Jahazi web app
IOTA_EXPLORER_URL=https://explorer.rebased.iota.org/testnet

# ============================================================================
# EXTERNAL INTEGRATIONS
# ============================================================================

# Satellite imagery mode: integrated, unavailable, or sandbox
SATELLITE_MODE=sandbox

# Which machinery produces a project's NDVI figure: sandbox (model output, always
# labelled as such) or opendata-s2 (Sentinel-2 L2A pixels read through s2-worker).
# Unset or an unknown name means sandbox.
SATELLITE_PROVIDER=sandbox

# s2-worker address and its internal bearer token. Both are required for
# SATELLITE_PROVIDER=opendata-s2; with either missing a live deployment answers
# unavailable rather than inventing a figure.
S2_WORKER_URL=
S2_WORKER_TOKEN=

# Registry mode: integrated, unavailable, or sandbox
REGISTRY_MODE=sandbox

# Payment mode: integrated, unavailable, or sandbox
PAYMENT_MODE=sandbox

# Evidence storage root directory
EVIDENCE_ROOT=data/evidence

# ============================================================================
# JAHAZI INTEGRATION
# ============================================================================

# Enable the Jahazi cross-platform integration (RestorationClaims, MRV links,
# contribution mirroring, activity matching).
JAHAZI_ENABLED=false

# Jahazi API base URL for MRV link push (e.g. https://api.jahazi.ke)
JAHAZI_WEBHOOK_URL=

# Shared HMAC secret for signing/verifying cross-platform payloads.
# Must match BAHARILINK_WEBHOOK_SECRET on the Jahazi side.
JAHAZI_WEBHOOK_SECRET=

# ============================================================================
# DEMO DATA (DEVELOPMENT ONLY)
# ============================================================================

# Seed demo data on startup (FORBIDDEN in production)
# Set to true for local development with realistic placeholder data
SEED_DEMO_DATA=false

# Password for demo accounts (REQUIRED if SEED_DEMO_DATA=true)
# Demo accounts: manager@, monitor@, verifier@, buyer@, finance@, admin@demo.baharimrv.local
DEMO_SEED_PASSWORD=
