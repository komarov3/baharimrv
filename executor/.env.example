# BahariMRV Executor — Environment Configuration
# Copy to .env and fill in values. Never commit .env to git.
#
# The executor is the BahariMRV gas station: it holds the sponsor wallet,
# builds Move PTBs for conservation_chain, signs and submits them to IOTA
# Rebased Testnet. The Go backend calls it via HTTP (POST /anchor).
#
# This wallet is SEPARATE from the Nanga fisheries executor wallet.
# Each platform manages its own gas and signing keys.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=9000

# ── Auth (shared secret between backend and executor) ─────────────────────────
# Generate: openssl rand -hex 32
# Set the same value in backend/.env as IOTA_EXECUTOR_API_KEY
API_KEY=

# ── IOTA network ──────────────────────────────────────────────────────────────
IOTA_RPC_URL=https://api.testnet.iota.cafe

# ── conservation_chain package (from deploy/deploy-chain.sh output) ───────────
IOTA_PACKAGE_ID=0x43a3977bc31cce20c6921d66cdb6b4e34a202ad43c612c6809036e76800d0853

# ── bahari_identity package (shared identity layer) ───────────────────────────
BAHARI_IDENTITY_PACKAGE_ID=0x931ed065a3b38921008d7be033d84605b58db10dfb9bb687ed4d3f8fbda8acf9

# ── Shared object IDs (created on first deploy, constant thereafter) ──────────
ANCHOR_REGISTRY_OBJECT_ID=0x5e35190fa03c290ad0ebab782d74db42bf77decc8fe3ba8dda894202ac97524b
IDENTITY_REGISTRY_OBJECT_ID=0x8007a9471be98d5b8bff3a676f663fb224ab181de04fe3e580149debf3874ac8
MRV_REGISTRY_OBJECT_ID=0x9165e1a88c6ee45420491603ffea2ec196df4fb2bb5c92da7545a302a2472a7a
CARBON_CREDIT_REGISTRY_OBJECT_ID=0xecdb2862cc81bb8068e368c61b7466a81a2ec9ace7f727d0b8b617ff1a666376
# AdminCap held by baharimrv-admin (0xdd78c8c6...f8) after deploy:
ADMIN_CAP_OBJECT_ID=0x392b98d96a089c2c58baf335f69d943346614f81dbfd5a33ecd0eab28d974d8d

# ── Sponsor / gas station wallet ──────────────────────────────────────────────
# This is the BahariMRV admin wallet that signs every on-chain transaction.
# It holds the AdminCap for conservation_chain (transferred from the deployer
# by deploy/deploy-chain.sh).
#
# Format: bech32 IOTA private key (iotaprivkey...) OR base64-encoded 32-byte seed.
# Retrieve from iota keystore: iota keytool export --key-identity <address>
#
# Address: 0xdd78c8c66b475962ca16192f7d302f04e6ffa2e6a85bee28c6bb09b65e01b6f8
# Fund at:  https://faucet.iota.cafe
SPONSOR_PRIVATE_KEY=

# ── Gas budget ────────────────────────────────────────────────────────────────
# Per-transaction gas budget in NANOS (1 IOTA = 1_000_000_000 NANOS).
# 50_000_000 = 0.05 IOTA — sufficient for all conservation_chain PTBs.
GAS_BUDGET=50000000

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
