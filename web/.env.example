# Backend origin. The client always appends /api/v1. Leave blank for same-origin deployment.
# Production: https://baharimrv-api.fly.dev (Fly.io deployment)
VITE_API_URL=https://baharimrv-api.fly.dev

# Optional project opened when the console first loads. Operators can change it in the UI.
VITE_DEFAULT_PROJECT_ID=

# Jahazi OIDC public client configuration. No client secret belongs in this file.
VITE_JAHAZI_CLIENT_ID=
VITE_JAHAZI_ISSUER=
VITE_JAHAZI_REDIRECT_URI=http://localhost:5173/auth/callback
