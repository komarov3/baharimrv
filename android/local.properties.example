# BahariMRV Android Configuration Example
# Copy to local.properties and supply environment-specific values
# Never commit local.properties with real credentials to git

# ============================================================================
# BACKEND API
# ============================================================================

# BahariMRV backend API base URL
# Production: https://baharimrv-api.fly.dev (Fly.io deployment)
# Development: http://localhost:8080 or http://10.0.2.2:8080 (Android emulator)
BAHARIMRV_API_BASE_URL=https://baharimrv-api.fly.dev

# ============================================================================
# JAHAZI SSO INTEGRATION
# ============================================================================

# Jahazi OAuth2/OIDC issuer URL (MUST be HTTPS in production)
JAHAZI_ISSUER_URL=https://auth.jahazi.ke

# OAuth2 client ID registered with Jahazi
JAHAZI_CLIENT_ID=baharimrv_android_client

# OAuth2 redirect URI (MUST match registration, custom scheme recommended)
# Format: baharimrv://auth/callback or https://app.baharimrv.ke/auth/callback
# Custom scheme is safer for native apps (no Universal Links collision)
JAHAZI_REDIRECT_URI=baharimrv://auth/callback

# ============================================================================
# MAPPING
# ============================================================================

# No map API key is required. The satellite map renders OpenStreetMap raster
# tiles through osmdroid, and NDVI tiles come from the authenticated backend
# above. There is no Google Maps SDK, billing account, or Play Services
# dependency for mapping.
